android_app {
    name: "NothingDirac",

    srcs: ["src/**/*.kt"],

    system_ext_specific: true,
    certificate: "platform",
    platform_apis: true,
    privileged: true,

    optimize: {
        optimize: true,
        proguard_flags_files: ["proguard.flags"],
        shrink_resources: true,
    },
    static_libs: [
        "org.lineageos.settings.resources",
    ],
}
