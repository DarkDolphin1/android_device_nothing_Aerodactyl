cc_library_static {
    name: "android.hardware.biometrics.fingerprint-service.nothing.lib",
    vendor_available: true,
    local_include_dirs: ["include"],
    srcs: [
        "LockoutTracker.cpp",
        "FingerprintEngine.cpp",
        "FingerprintEngineUdfps.cpp",
        "Fingerprint.cpp",
        "Session.cpp",
        "FingerprintConfig.cpp",
        "main.cpp",
    ],
    stl: "c++_static",
    shared_libs: [
        "libbinder_ndk",
        "libhardware",
        "liblog",
    ],
    whole_static_libs: [
        "libandroid.hardware.biometrics.fingerprint.NothingProps",
        "libbase",
        "android.hardware.biometrics.fingerprint-V4-ndk",
        "android.hardware.biometrics.common-V4-ndk",
        "android.hardware.biometrics.common.thread",
        "android.hardware.biometrics.common.util",
        "android.hardware.biometrics.common.config",
        "android.hardware.keymaster-V4-ndk",
    ],
}

cc_binary {
    name: "android.hardware.biometrics.fingerprint-service.nothing",
    //system_ext_specific: true,
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["fingerprint-default.rc"],
    vintf_fragment_modules: ["android.hardware.biometrics.fingerprint-service.nothing.vintf"],
    local_include_dirs: ["include"],
    srcs: [
    ],
    stl: "c++_static",
    shared_libs: [
        "libbinder_ndk",
        "liblog",
    ],
    whole_static_libs: [
        "android.hardware.biometrics.fingerprint-service.lib",
    ],
}

vintf_fragment {
    name: "android.hardware.biometrics.fingerprint-service.nothing.vintf",
    src: "fingerprint-default.xml",
    vendor: true,
}

sysprop_library {
    name: "android.hardware.biometrics.fingerprint.NothingProps",
    srcs: ["fingerprint.sysprop"],
    property_owner: "Platform",
    vendor_available: true,
}
